---
import ArticleList from "@components/controls/ArticleList.astro";
import ArchivePanel from "@components/controls/ArchivePanel.svelte";
import ArchiveHeatmap from "@components/widget/ArchiveHeatmap.astro";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { Icon } from "astro-icon/components";
import { externalMomentsConfig } from "@/config/externalMomentsConfig";
import { getArchiveList, getSortedPostsList } from "@/utils/content-utils";

const extConfig =
	externalMomentsConfig.enable && externalMomentsConfig.gistId
		? {
				gistId: externalMomentsConfig.gistId,
				fileName: externalMomentsConfig.fileName,
			}
		: null;

const archiveList = await getArchiveList();
const sortedPostsList = await getSortedPostsList();
const title = i18n(I18nKey.archive);
---

<MainGridLayout title={title}>
  <div class="relative w-full min-h-32 overflow-hidden">
    <ArticleList posts={sortedPostsList} />
  </div>
</MainGridLayout>