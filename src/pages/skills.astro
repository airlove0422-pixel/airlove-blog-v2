---
import { Icon } from "astro-icon/components";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { skillsConfig } from "@/config/skillsConfig";

const groups = [...new Set(skillsConfig.items.map((item) => item.group))];
---

<MainGridLayout title="技能" description="正在学习与使用的技术">
	<div class="card-base px-5 py-6 md:px-9 md:py-8">
		<div class="flex items-center gap-3 mb-2">
			<Icon name="material-symbols:code" class="text-3xl" />
			<h1 class="text-3xl font-bold">技能</h1>
		</div>
		<p class="text-neutral-600 dark:text-neutral-400 mb-8">这不是“精通清单”，而是我的当前学习地图。</p>
		<div class="space-y-7">
			{groups.map((group) => (
				<section>
					<h2 class="text-lg font-bold mb-3">{group}</h2>
					<div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3">
						{skillsConfig.items.filter((item) => item.group === group).map((item) => (
							<div class="flex items-center gap-3 rounded-xl border border-black/10 dark:border-white/10 px-4 py-3 bg-white/45 dark:bg-black/20">
								<Icon name={item.icon} class="text-2xl" />
								<span class="font-medium">{item.name}</span>
							</div>
						))}
					</div>
				</section>
			))}
		</div>
	</div>
</MainGridLayout>
