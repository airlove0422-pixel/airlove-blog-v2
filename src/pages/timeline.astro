---
import { Icon } from "astro-icon/components";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

const events = [
	{
		date: "2026-07-21",
		title: "Airlove Blog",
		description: "开始搭建并持续改造自己的个人博客。",
	},
	{
		date: "2026",
		title: "古琴文化学习小程序",
		description: "推进小程序前端、Django 后端、数据库与识谱功能。",
	},
	{
		date: "2026",
		title: "智能睡眠数据分析与温控系统",
		description: "围绕睡眠数据、LSTM 预测和智能温控开展学习与实践。",
	},
];
---

<MainGridLayout title="时间线" description="记录项目与成长节点">
	<div class="card-base px-5 py-6 md:px-9 md:py-8">
		<div class="flex items-center gap-3 mb-8">
			<Icon name="material-symbols:timeline" class="text-3xl" />
			<div>
				<h1 class="text-3xl font-bold">时间线</h1>
				<p class="text-neutral-600 dark:text-neutral-400 mt-1">记录项目与成长节点</p>
			</div>
		</div>
		<div class="relative pl-7 before:absolute before:left-[7px] before:top-2 before:bottom-2 before:w-px before:bg-black/15 dark:before:bg-white/20">
			{events.map((event) => (
				<article class="relative pb-8 last:pb-0">
					<span class="absolute -left-7 top-1.5 w-[15px] h-[15px] rounded-full bg-(--primary) ring-4 ring-white dark:ring-neutral-900"></span>
					<time class="text-sm text-neutral-500">{event.date}</time>
					<h2 class="text-xl font-bold mt-1">{event.title}</h2>
					<p class="text-neutral-600 dark:text-neutral-400 leading-7 mt-2">{event.description}</p>
				</article>
			))}
		</div>
	</div>
</MainGridLayout>
