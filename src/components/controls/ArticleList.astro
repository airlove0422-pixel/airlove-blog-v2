---
import { getPostUrlBySlug } from "@/utils/url-utils";

interface PostItem {
	id: string;
	data: {
		title: string;
		description?: string;
		tags?: string[];
		category?: string | null;
		published: Date | string;
		image?: string;
	};
}

interface Props {
	posts: PostItem[];
}

const { posts = [] } = Astro.props;

function formatDate(date: Date | string) {
	const value = new Date(date);

	return `${value.getFullYear()}-${String(value.getMonth() + 1).padStart(
		2,
		"0",
	)}-${String(value.getDate()).padStart(2, "0")}`;
}
---

<section class="article-list">
	<header class="article-list-header">
		<div class="article-list-title">
			<span class="title-icon">
				<svg viewBox="0 0 24 24" aria-hidden="true">
					<path d="M7 3h8l4 4v14H7z"></path>
					<path d="M15 3v5h5"></path>
					<path d="M10 12h6M10 16h6"></path>
				</svg>
			</span>

			<h1>文章列表</h1>
		</div>

		<div class="article-list-tabs">
			<button type="button" class="article-tab">
				<span>▦</span>
				分类
			</button>

			<button type="button" class="article-tab active">
				<span>▤</span>
				归档
			</button>
		</div>
	</header>

	<div class="article-card-list">
		{
			posts.map((post) => (
				<a
					class:list={[
						"article-card",
						!post.data.image && "article-card-no-image",
					]}
					href={getPostUrlBySlug(post.id)}
				>
					<div class="article-card-content">
						<h2 class="article-card-title">{post.data.title}</h2>

						<div class="article-card-meta">
							{post.data.tags?.map((tag) => (
								<span class="article-tag"># {tag}</span>
							))}

							<span class="article-meta-item">
								<svg viewBox="0 0 24 24" aria-hidden="true">
									<rect x="4" y="6" width="16" height="14" rx="2" />
									<path d="M8 3v5M16 3v5M4 10h16" />
								</svg>

								{formatDate(post.data.published)}
							</span>

							{
								post.data.category && (
									<span class="article-meta-item">
										<svg viewBox="0 0 24 24" aria-hidden="true">
											<path d="M3 6h7l2 2h9v11H3z" />
										</svg>

										{post.data.category}
									</span>
								)
							}
						</div>

						<p class="article-card-description">
							{post.data.description || "这篇文章暂时还没有填写简介。"}
						</p>
					</div>

					{
						post.data.image && (
							<div class="article-card-cover">
								<img
									src={post.data.image}
									alt={post.data.title}
									loading="lazy"
								/>
								<div class="article-cover-mask" />
							</div>
						)
					}
				</a>
			))
		}
	</div>
</section>

<style>
	.article-list {
		width: 100%;
	}

	.article-list-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 20px;
		margin-bottom: 22px;
	}

	.article-list-title {
		display: flex;
		align-items: center;
		gap: 12px;
	}

	.article-list-title h1 {
		margin: 0;
		color: var(--primary);
		font-size: 28px;
		font-weight: 800;
		letter-spacing: 0.5px;
	}

	.title-icon {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 36px;
		height: 36px;
		color: var(--primary);
	}

	.title-icon svg {
		width: 30px;
		height: 30px;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.8;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.article-list-tabs {
		display: flex;
		align-items: center;
		gap: 10px;
	}

	.article-tab {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 7px;
		min-width: 84px;
		height: 38px;
		padding: 0 16px;
		color: var(--primary);
		background: rgba(var(--primary-rgb), 0.08);
		border: 1px solid rgba(var(--primary-rgb), 0.1);
		border-radius: 12px;
		font-size: 14px;
		font-weight: 700;
		cursor: pointer;
		transition:
			transform 0.2s ease,
			background 0.2s ease;
	}

	.article-tab:hover {
		background: rgba(var(--primary-rgb), 0.14);
		transform: translateY(-2px);
	}

	.article-tab.active {
		color: white;
		background: var(--primary);
		box-shadow: 0 8px 20px rgba(var(--primary-rgb), 0.22);
	}

	.article-card-list {
		display: flex;
		flex-direction: column;
		gap: 20px;
	}

	.article-card {
		position: relative;
		display: flex;
		min-height: 210px;
		overflow: hidden;
		color: inherit;
		background: var(--card-bg);
		border: 1px solid rgba(148, 163, 184, 0.1);
		border-radius: 20px;
		box-shadow: 0 8px 28px rgba(40, 50, 75, 0.08);
		text-decoration: none;
		transition:
			transform 0.25s ease,
			box-shadow 0.25s ease;
	}

	.article-card:hover {
		transform: translateY(-5px);
		box-shadow: 0 16px 38px rgba(40, 50, 75, 0.14);
	}

	.article-card-content {
		position: relative;
		z-index: 2;
		flex: 1;
		min-width: 0;
		padding: 30px 32px;
	}

	.article-card-title {
		margin: 0 0 15px;
		color: var(--primary);
		font-size: 25px;
		font-weight: 800;
		line-height: 1.35;
	}

	.article-card-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 9px 14px;
		margin-bottom: 18px;
		color: var(--text-color);
		font-size: 13px;
		opacity: 0.78;
	}

	.article-tag {
		padding: 4px 10px;
		color: var(--primary);
		background: rgba(var(--primary-rgb), 0.09);
		border-radius: 999px;
		font-weight: 700;
	}

	.article-meta-item {
		display: inline-flex;
		align-items: center;
		gap: 5px;
	}

	.article-meta-item svg {
		width: 15px;
		height: 15px;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.8;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.article-card-description {
		display: -webkit-box;
		max-width: 650px;
		margin: 0;
		overflow: hidden;
		color: var(--text-color);
		font-size: 15px;
		line-height: 1.8;
		opacity: 0.72;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 3;
	}

	.article-card-cover {
		position: relative;
		flex: 0 0 42%;
		max-width: 430px;
		min-height: 210px;
		overflow: hidden;
	}

	.article-card-cover img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.45s ease;
	}

	.article-card:hover .article-card-cover img {
		transform: scale(1.05);
	}

	.article-cover-mask {
		position: absolute;
		inset: 0;
		background: linear-gradient(
			90deg,
			var(--card-bg) 0%,
			rgba(255, 255, 255, 0.72) 14%,
			rgba(255, 255, 255, 0.05) 65%
		);
	}

	.article-card-no-image .article-card-description {
		max-width: none;
	}

	:global(html.dark) .article-cover-mask {
		background: linear-gradient(
			90deg,
			var(--card-bg) 0%,
			rgba(30, 35, 47, 0.72) 14%,
			rgba(30, 35, 47, 0.04) 65%
		);
	}

	@media (max-width: 768px) {
		.article-list-header {
			align-items: flex-start;
			flex-direction: column;
		}

		.article-list-title h1 {
			font-size: 24px;
		}

		.article-card {
			flex-direction: column-reverse;
		}

		.article-card-content {
			padding: 22px 20px 25px;
		}

		.article-card-title {
			font-size: 21px;
		}

		.article-card-cover {
			flex: none;
			width: 100%;
			max-width: none;
			height: 180px;
			min-height: 180px;
		}

		.article-cover-mask {
			background: linear-gradient(
				0deg,
				var(--card-bg) 0%,
				rgba(255, 255, 255, 0.08) 45%
			);
		}

		:global(html.dark) .article-cover-mask {
			background: linear-gradient(
				0deg,
				var(--card-bg) 0%,
				rgba(30, 35, 47, 0.05) 45%
			);
		}
	}
</style>