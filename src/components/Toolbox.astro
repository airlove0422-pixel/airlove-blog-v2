<!-- src/components/Toolbox.astro -->

<button
	id="airlove-toolbox-trigger"
	class="toolbox-trigger"
	type="button"
	aria-label="打开工具箱"
	title="工具箱"
>
	<svg viewBox="0 0 24 24" aria-hidden="true">
		<rect x="4" y="7" width="16" height="13" rx="3"></rect>
		<path d="M9 7V5.5A1.5 1.5 0 0 1 10.5 4h3A1.5 1.5 0 0 1 15 5.5V7"></path>
		<path d="M4 12h16"></path>
		<path d="M10 12v2h4v-2"></path>
	</svg>
</button>

<section
	id="airlove-toolbox-window"
	class="toolbox-window"
	aria-label="Airlove 工具箱"
	hidden
>
	<header class="toolbox-topbar">
		<div class="toolbox-clock">
			<span id="toolbox-current-time">00:00:00</span>
			<span class="toolbox-date" id="toolbox-current-date"></span>
		</div>

		<div class="window-buttons">
			<span class="window-dot dot-yellow"></span>
			<span class="window-dot dot-green"></span>
			<button
				id="airlove-toolbox-close"
				class="window-dot dot-red"
				type="button"
				aria-label="关闭工具箱"
			></button>
		</div>
	</header>

	<div class="toolbox-content">
		<div class="toolbox-grid">
			<button class="tool-app" type="button" data-tool="coin">
				<span class="tool-icon icon-orange">
					<svg viewBox="0 0 48 48">
						<circle cx="24" cy="24" r="17"></circle>
						<circle cx="24" cy="24" r="12"></circle>
						<path d="M19 18h10M19 30h10M24 17v14"></path>
						<path d="M19 21c0-2 2-3 5-3s5 1 5 3-2 3-5 3-5 1-5 3 2 3 5 3 5-1 5-3"></path>
					</svg>
				</span>
				<span class="tool-name">硬币</span>
			</button>

			<button class="tool-app" type="button" data-tool="dice">
				<span class="tool-icon icon-purple">
					<svg viewBox="0 0 48 48">
						<rect x="8" y="8" width="32" height="32" rx="8"></rect>
						<circle cx="17" cy="17" r="2"></circle>
						<circle cx="31" cy="17" r="2"></circle>
						<circle cx="24" cy="24" r="2"></circle>
						<circle cx="17" cy="31" r="2"></circle>
						<circle cx="31" cy="31" r="2"></circle>
					</svg>
				</span>
				<span class="tool-name">骰子</span>
			</button>

			<button class="tool-app" type="button" data-tool="rps">
				<span class="tool-icon icon-pink">
					<svg viewBox="0 0 48 48">
						<path d="M17 23v-8a3 3 0 0 1 6 0v7"></path>
						<path d="M23 22V11a3 3 0 0 1 6 0v11"></path>
						<path d="M29 22v-8a3 3 0 0 1 6 0v12"></path>
						<path d="M17 21l-3-3a3.5 3.5 0 0 0-5 5l8 11c2 3 5 5 10 5 7 0 12-5 12-12v-7a3 3 0 0 0-6 0v2"></path>
					</svg>
				</span>
				<span class="tool-name">猜拳</span>
			</button>

			<button class="tool-app" type="button" data-tool="password">
				<span class="tool-icon icon-green">
					<svg viewBox="0 0 48 48">
						<rect x="9" y="15" width="30" height="25" rx="6"></rect>
						<path d="M16 15v-3a8 8 0 0 1 16 0v3"></path>
						<circle cx="24" cy="27" r="3"></circle>
						<path d="M24 30v5"></path>
					</svg>
				</span>
				<span class="tool-name">密码</span>
			</button>

			<button class="tool-app" type="button" data-tool="note">
				<span class="tool-icon icon-orange">
					<svg viewBox="0 0 48 48">
						<rect x="10" y="7" width="28" height="34" rx="5"></rect>
						<path d="M17 17h14M17 24h14M17 31h9"></path>
						<path d="M17 7v6M31 7v6"></path>
					</svg>
				</span>
				<span class="tool-name">记事本</span>
			</button>

			<button class="tool-app" type="button" data-tool="unit">
				<span class="tool-icon icon-cyan">
					<svg viewBox="0 0 48 48">
						<path d="M15 9v30M33 9v30"></path>
						<path d="M10 15l5-6 5 6M28 33l5 6 5-6"></path>
						<path d="M22 17h12M14 31h12"></path>
					</svg>
				</span>
				<span class="tool-name">换算</span>
			</button>

			<button class="tool-app" type="button" data-tool="base">
				<span class="tool-icon icon-purple">
					<svg viewBox="0 0 48 48">
						<path d="M12 15h23"></path>
						<path d="M30 10l5 5-5 5"></path>
						<path d="M36 33H13"></path>
						<path d="M18 28l-5 5 5 5"></path>
						<circle cx="15" cy="15" r="4"></circle>
						<rect x="29" y="29" width="8" height="8" rx="2"></rect>
					</svg>
				</span>
				<span class="tool-name">进制</span>
			</button>

			<button class="tool-app" type="button" data-tool="calculator">
				<span class="tool-icon icon-orange">
					<svg viewBox="0 0 48 48">
						<rect x="10" y="6" width="28" height="36" rx="5"></rect>
						<rect x="15" y="11" width="18" height="8" rx="2"></rect>
						<circle cx="17" cy="26" r="1.6"></circle>
						<circle cx="24" cy="26" r="1.6"></circle>
						<circle cx="31" cy="26" r="1.6"></circle>
						<circle cx="17" cy="34" r="1.6"></circle>
						<circle cx="24" cy="34" r="1.6"></circle>
						<circle cx="31" cy="34" r="1.6"></circle>
					</svg>
				</span>
				<span class="tool-name">计算器</span>
			</button>
		</div>
	</div>

	<footer class="toolbox-footer">
		<span></span>
		<span class="footer-home"></span>
		<span></span>
	</footer>
</section>

<style>
	.toolbox-trigger {
		position: fixed;
		left: 22px;
		bottom: 22px;
		z-index: 9998;

		display: flex;
		align-items: center;
		justify-content: center;

		width: 48px;
		height: 48px;
		padding: 0;

		color: #64748b;
		background: rgba(255, 255, 255, 0.86);
		border: 1px solid rgba(255, 255, 255, 0.9);
		border-radius: 16px;

		box-shadow:
			0 10px 30px rgba(49, 61, 89, 0.16),
			inset 0 1px 0 rgba(255, 255, 255, 0.9);

		backdrop-filter: blur(18px);
		-webkit-backdrop-filter: blur(18px);

		cursor: pointer;
		transition:
			transform 0.22s ease,
			box-shadow 0.22s ease;
	}

	.toolbox-trigger svg {
		width: 24px;
		height: 24px;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.7;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.toolbox-trigger:hover {
		transform: translateY(-3px);
		box-shadow: 0 14px 36px rgba(49, 61, 89, 0.22);
	}

	.toolbox-window {
		position: fixed;
		left: 20px;
		bottom: 82px;
		z-index: 9999;

		display: flex;
		flex-direction: column;

		width: 292px;
		height: 560px;
		max-height: calc(100vh - 105px);

		overflow: hidden;

		color: #536178;
		background: rgba(255, 255, 255, 0.94);
		border: 1px solid rgba(255, 255, 255, 0.92);
		border-radius: 32px;

		box-shadow:
			0 26px 70px rgba(42, 51, 78, 0.22),
			inset 0 1px 0 rgba(255, 255, 255, 0.94);

		backdrop-filter: blur(24px);
		-webkit-backdrop-filter: blur(24px);

		transform-origin: left bottom;
		animation: toolbox-window-in 0.26s cubic-bezier(0.2, 0.9, 0.25, 1.15);
	}

	.toolbox-window[hidden] {
		display: none !important;
	}

	.toolbox-topbar {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		flex-shrink: 0;

		min-height: 66px;
		padding: 18px 20px 10px;
	}

	.toolbox-clock {
		display: flex;
		flex-direction: column;
		gap: 3px;
	}

	#toolbox-current-time {
		color: #64748b;
		font-size: 17px;
		font-weight: 700;
		letter-spacing: 0.5px;
	}

	.toolbox-date {
		color: #a4afbf;
		font-size: 10px;
		font-weight: 600;
	}

	.window-buttons {
		display: flex;
		gap: 7px;
		padding-top: 2px;
	}

	.window-dot {
		width: 10px;
		height: 10px;
		padding: 0;

		border: 0;
		border-radius: 50%;
	}

	.dot-yellow {
		background: #f8c75c;
	}

	.dot-green {
		background: #66d493;
	}

	.dot-red {
		background: #f48181;
		cursor: pointer;
		transition: transform 0.18s ease;
	}

	.dot-red:hover {
		transform: scale(1.3);
	}

	.toolbox-content {
		flex: 1;
		padding: 8px 16px 15px;
		overflow-y: auto;
		scrollbar-width: none;
	}

	.toolbox-content::-webkit-scrollbar {
		display: none;
	}

	.toolbox-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		column-gap: 10px;
		row-gap: 9px;
	}

	.tool-app {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 7px;

		min-height: 101px;
		padding: 10px 6px;

		color: inherit;
		background: transparent;
		border: 0;
		border-radius: 22px;

		cursor: pointer;
		transition:
			background 0.18s ease,
			transform 0.18s ease,
			box-shadow 0.18s ease;
	}

	.tool-app:hover {
		background: rgba(244, 247, 251, 0.92);
		box-shadow: 0 9px 22px rgba(56, 70, 101, 0.08);
		transform: translateY(-3px);
	}

	.tool-app:active {
		transform: scale(0.96);
	}

	.tool-icon {
		display: flex;
		align-items: center;
		justify-content: center;

		width: 54px;
		height: 54px;
	}

	.tool-icon svg {
		width: 46px;
		height: 46px;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.8;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.tool-icon svg circle {
		fill: none;
	}

	.tool-name {
		color: #526077;
		font-size: 14px;
		font-weight: 650;
	}

	.icon-orange {
		color: #f59e0b;
	}

	.icon-purple {
		color: #6865e8;
	}

	.icon-pink {
		color: #ec6aa7;
	}

	.icon-green {
		color: #24b68a;
	}

	.icon-cyan {
		color: #16a9c6;
	}

	.toolbox-footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-shrink: 0;

		height: 37px;
		padding: 0 28px;

		border-top: 1px solid rgba(226, 232, 240, 0.62);
	}

	.footer-home {
		width: 34px;
		height: 4px;
		background: #d2d9e3;
		border-radius: 999px;
	}

	@keyframes toolbox-window-in {
		from {
			opacity: 0;
			transform: translateY(15px) scale(0.92);
		}

		to {
			opacity: 1;
			transform: translateY(0) scale(1);
		}
	}

	@media (max-width: 600px) {
		.toolbox-trigger {
			left: 14px;
			bottom: 16px;
		}

		.toolbox-window {
			left: 12px;
			bottom: 76px;

			width: calc(100vw - 24px);
			height: min(620px, calc(100vh - 92px));
			max-height: calc(100vh - 92px);

			border-radius: 30px;
		}

		.toolbox-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.tool-app {
			min-height: 105px;
		}
	}

	:global(html.dark) .toolbox-trigger,
	:global(html.dark) .toolbox-window {
		color: #cbd5e1;
		background: rgba(28, 32, 43, 0.93);
		border-color: rgba(255, 255, 255, 0.08);
	}

	:global(html.dark) .tool-app:hover {
		background: rgba(255, 255, 255, 0.06);
	}

	:global(html.dark) .tool-name,
	:global(html.dark) #toolbox-current-time {
		color: #d5dbea;
	}

	:global(html.dark) .toolbox-date {
		color: #8994a8;
	}

	:global(html.dark) .toolbox-footer {
		border-top-color: rgba(255, 255, 255, 0.07);
	}
</style>

<script>
	function initializeAirloveToolbox() {
		const trigger = document.getElementById("airlove-toolbox-trigger");
		const windowElement = document.getElementById("airlove-toolbox-window");
		const closeButton = document.getElementById("airlove-toolbox-close");
		const timeElement = document.getElementById("toolbox-current-time");
		const dateElement = document.getElementById("toolbox-current-date");

		if (!trigger || !windowElement || !closeButton) return;

		if (trigger.dataset.ready === "true") return;
		trigger.dataset.ready = "true";

		const updateClock = () => {
			const now = new Date();

			if (timeElement) {
				timeElement.textContent = now.toLocaleTimeString("zh-CN", {
					hour12: false,
					hour: "2-digit",
					minute: "2-digit",
					second: "2-digit",
				});
			}

			if (dateElement) {
				dateElement.textContent = now.toLocaleDateString("zh-CN", {
					month: "long",
					day: "numeric",
					weekday: "short",
				});
			}
		};

		updateClock();
		window.setInterval(updateClock, 1000);

		trigger.addEventListener("click", () => {
			windowElement.hidden = !windowElement.hidden;
		});

		closeButton.addEventListener("click", () => {
			windowElement.hidden = true;
		});

		document.addEventListener("keydown", (event) => {
			if (event.key === "Escape") {
				windowElement.hidden = true;
			}
		});
	}

	initializeAirloveToolbox();
	document.addEventListener("astro:page-load", initializeAirloveToolbox);
</script>